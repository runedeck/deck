@prefix rune:    <https://runedeck.dev/ns#> .
@prefix id:      <https://runedeck.dev/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Smoke-test instance graph for the shapes gate. Every node below
# carries a seeded defect except the first, so a validation run must
# report exactly four Violations and thirteen Warnings:
#   rudof shacl-validate -s ontology/shapes.ttl ontology/smoke/instances.ttl

# A conforming record.
id:DECK-0010 a rune:DecisionRecord ;
    dcterms:identifier "DECK-0010" ;
    dcterms:title "Declared World in RDF" .

# The duplicate: one IRI, two titles, two source files, and a
# malformed identifier.
id:DECK-0002 a rune:DecisionRecord ;
    dcterms:identifier "DECK-0002", "DECK-2" ;
    dcterms:title "Temporary Adoption State", "Benchmark Execution Ladder" ;
    rune:sourcePath "docs/decisions/DECK-0002 Temporary Adoption State.md",
        "docs/decisions/DECK-0002 Benchmark Execution Ladder.md" .

# A reference that does not resolve to a declared record.
id:DECK-0099 a rune:DecisionRecord ;
    dcterms:identifier "DECK-0099" ;
    dcterms:title "Ghost" ;
    dcterms:relation id:DECK-4242 .

# A rule without a verdict pointer.
id:UseEfficientCLI a rune:Rule ;
    dcterms:title "UseEfficientCLI" .

# A conforming proof: an entity IRI under /id/, a declared kind, and
# exit status zero. It must pass without rune.ttl loaded, which is why
# the kinds are enumerated. A proof that lacks its exit status reports
# twice, once for the count and once for the value.
id:proof-checks-1 a rune:Proof ;
    rune:proves id:commit-eafc72cc ;
    rune:proofKind rune:checks ;
    rune:exitStatus 0 .

# A receipt of a failed run: not a proof, one Warning for the exit status.
id:proof-failed a rune:Proof ;
    rune:proves id:commit-deadbeef ;
    rune:proofKind rune:checks ;
    rune:exitStatus 1 .

# A proof of a commit outside /id/: one Warning for the pattern, and the
# only node that exercises it, so weakening the pattern changes the count.
id:proof-foreign a rune:Proof ;
    rune:proves <https://example.org/commit/1> ;
    rune:proofKind rune:checks ;
    rune:exitStatus 0 .

# A proof without a candidate commit, a kind, or an exit status: four
# Warnings, because the missing exit status reports for its count and its
# value.
id:proof-orphan a rune:Proof .

# A proof with a literal for its commit and a kind outside the scheme:
# one Warning each.
id:proof-malformed a rune:Proof ;
    rune:proves "eafc72cc" ;
    rune:proofKind rune:vibes .

# A CORE record is valid: the family is any uppercase word (2026-09-20).
<https://runedeck.dev/id/CORE-0001> a rune:DecisionRecord ;
    dcterms:identifier "CORE-0001" ;
    dcterms:title "Markdown as System Language" ;
    rune:sourcePath "docs/decisions/CORE-0001 Markdown as System Language.md" .

# A lowercase family is not an identifier: one Violation.
<https://runedeck.dev/id/core-0002> a rune:DecisionRecord ;
    dcterms:identifier "core-0002" ;
    dcterms:title "Lowercase family" ;
    rune:sourcePath "docs/decisions/core-0002 Lowercase family.md" .
