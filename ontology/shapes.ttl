@prefix rune:    <https://runedeck.ai/ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# The permitted world (DECK-0010). SHACL validates under the closed-world
# assumption, so a shape violation is a deterministic failure. This is
# the gate. The ontology in rune.ttl only describes.
#
# The instance graph comes from the extractor, which mints one IRI per
# record identifier under https://runedeck.ai/id/. Two files that claim
# one identifier therefore merge into one node, and the duplicate shows
# up as a cardinality violation on that node.

# Axiom record-id-unique: one identifier names one record.
rune:DecisionRecordShape a sh:NodeShape ;
    sh:targetClass rune:DecisionRecord ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z]+-[0-9]{4}$" ;
        sh:message "A decision record carries exactly one FAMILY-NNNN identifier, such as DECK-0001 or CORE-0001." ;
    ] ;
    # A draft inside its change (`adr.md`, status proposed) has no
    # identifier yet; archive assigns it. Every other record has one.
    sh:or (
        [ sh:property [ sh:path rune:status ; sh:hasValue "proposed" ] ]
        [ sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ] ]
    ) ;
    sh:message "A record that is not a proposed draft carries a FAMILY-NNNN identifier." ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        # Two files with one identifier merge into one node with two
        # titles, so this constraint detects the duplicate.
        # The DECK-0002 collision is resolved, so duplicates now block.
        sh:severity sh:Violation ;
        sh:message "Two records share one identifier." ;
    ] ;
    sh:property [
        sh:path rune:sourcePath ;
        sh:maxCount 1 ;
        # Identical duplicate files produce identical triples that RDF
        # deduplicates, so the title constraint alone cannot fire. The
        # per-file sourcePath makes every duplicate structurally
        # visible. The resolved collision makes this constraint blocking.
        sh:severity sh:Violation ;
        sh:message "Two source files claim one record identifier." ;
    ] ;
    # Axiom references-resolve: every related entry names a record that
    # exists in the extracted graph with the declared type. The corpus
    # conformed on 2026-09-23 (DECK-0006 and DECK-0019 were the last
    # dangling entries), so this blocks.
    sh:property [
        sh:path dcterms:relation ;
        sh:class rune:DecisionRecord ;
        sh:severity sh:Violation ;
        sh:message "A related entry names a decision record that does not exist." ;
    ] ;
    # Axiom status-is-asserted (2026-09-23): the frontmatter status is the
    # authority and a rule only catches a lie. Every record states one
    # status from the lifecycle. Warning until the exporter with
    # rune:status (cli #70, #71) is installed, then Violation.
    sh:property [
        sh:path rune:status ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "proposed" "accepted" "deprecated" "superseded" ) ;
        sh:severity sh:Warning ;
        sh:message "A record carries one status: proposed, accepted, deprecated, or superseded." ;
    ] ;
    # Axiom supersession-is-directed: `supersedes` names an existing
    # record. Self-replacement and a cycle need a SPARQL check, not Core.
    sh:property [
        sh:path dcterms:replaces ;
        sh:class rune:DecisionRecord ;
        sh:severity sh:Violation ;
        sh:message "A supersedes entry names a decision record that does not exist." ;
    ] .

# Axiom archived-is-not-proposed: a record under docs/decisions/ has left
# its change, so its status is never proposed. A draft under docs/changes/
# is proposed. Warning until the new exporter is installed.
rune:PlacedRecordShape a sh:NodeShape ;
    sh:targetClass rune:DecisionRecord ;
    sh:or (
        [ sh:property [ sh:path rune:sourcePath ; sh:minCount 1 ; sh:pattern "^docs/changes/" ] ]
        [ sh:property [ sh:path rune:status ; sh:in ( "accepted" "deprecated" "superseded" ) ] ]
    ) ;
    sh:severity sh:Warning ;
    sh:message "A record under docs/decisions/ says accepted, deprecated, or superseded, never proposed." .

# Axiom superseded-says-so: the record a successor replaces states
# status superseded, so the two files agree. Warning until the exporter
# emits rune:status (cli #70), then Violation.
rune:SupersededShape a sh:NodeShape ;
    sh:targetObjectsOf dcterms:replaces ;
    sh:property [
        sh:path rune:status ;
        sh:hasValue "superseded" ;
        sh:severity sh:Warning ;
        sh:message "A record that a successor replaces does not say status superseded." ;
    ] .

# Axiom term-draft-is-declared-debt (2026-10-17): a term may carry one
# status, and the only value is draft, which the fixer writes for a link
# nobody has defined yet. The validator warns while the change is active.
# The archiver refuses the change. A term is a class, a property, or a
# concept, so the shape targets those three kinds and never a record,
# whose label an exporter may one day emit beside its status. The term
# pages render from the ontology, which the graph export does not carry,
# so this shape fires on the smoke fixture and on any graph that includes
# the terms.
rune:TermShape a sh:NodeShape ;
    sh:targetClass rdfs:Class, rdf:Property, skos:Concept ;
    # A status on a term means a draft: declared debt, so a Warning.
    sh:property [
        sh:path rune:status ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:message "A term carries a draft status: the fixer added it and nobody has defined it yet. Define it before archive." ;
    ] ;
    # Any other value is a malformed term, not a draft.
    sh:property [
        sh:path rune:status ;
        sh:in ( "draft" ) ;
        sh:severity sh:Violation ;
        sh:message "A term carries a status other than draft." ;
    ] .

# Axiom rule-carries-verdict: a rule links to bench evidence, because a
# rule costs context on every turn (DECK-0001, DECK-0003).
# Severity is Warning while existing rules gain verdicts. The flip to
# Violation is a one-line change recorded in tasks.md.
rune:RuleShape a sh:NodeShape ;
    sh:targetClass rune:Rule ;
    sh:property [
        sh:path rune:verdict ;
        sh:minCount 1 ;
        sh:class rune:Verdict ;
        sh:severity sh:Warning ;
        sh:message "A rule carries no bench verdict pointer. Run BenchArtifact and record the verdict." ;
    ] .

# Axiom proof-covers-a-candidate: a proof names the commit it covers and
# the kind of check it records (DECK-0014). Severity is Warning until
# the first ContinuousIntegration receipts are extracted as proofs.
rune:ProofShape a sh:NodeShape ;
    sh:targetClass rune:Proof ;
    # One commit, as an IRI under /id/. A literal or a second value is a
    # malformed proof, not a proof of two commits.
    sh:property [
        sh:path rune:proves ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://runedeck\\.ai/id/" ;
        sh:severity sh:Warning ;
        sh:message "A proof names no candidate commit, more than one, or a value that is not an entity IRI under /id/." ;
    ] ;
    # A proof is a passing receipt. A run that exited nonzero is a receipt
    # and a finding, never a proof, so the status is required and zero.
    sh:property [
        sh:path rune:exitStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue 0 ;
        sh:severity sh:Warning ;
        sh:message "A proof carries no exit status, or one that is not zero." ;
    ] ;
    # The permitted kinds are enumerated here because the hook validates
    # the instance graph alone: the rdf:type triples that make rune:checks
    # a ProofKind live in rune.ttl, which the shapes never load.
    sh:property [
        sh:path rune:proofKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( rune:checks rune:behavior ) ;
        sh:severity sh:Warning ;
        sh:message "A proof names no kind, more than one, or a kind outside rune:proofKinds." ;
    ] .
