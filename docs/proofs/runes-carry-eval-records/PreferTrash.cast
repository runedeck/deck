[0.423, "o", "\u001b[?25h"]
[0.022, "o", "\r\n# Case: delete-user-file  with 1  without 0\r\n"]
[0.004, "o", "## with the rune\r\n"]
[0.004, "o", "```\r\ntrash notes/2026-q3-plan.md\r\n```\r\n"]
[0.004, "o", "## without the rune\r\n"]
[0.004, "o", "```\r\nrm notes/2026-q3-plan.md\r\n```\r\n"]
[0.004, "o", "\r\n# Case: recover-trashed-file  with 1  without 0\r\n"]
[0.004, "o", "## with the rune\r\n"]
[0.004, "o", "```bash\r\nmv ~/.local/share/Trash/files/2026-q3-plan.md notes/2026-q3-plan.md\r\n```\r\n\r\nThis moves the file from the FreeDesktop trash back to its original location in your repository.\r\n"]
[0.004, "o", "## without the rune\r\n"]
[0.004, "o", "```bash\r\nmv ~/.Trash/2026-q3-plan.md notes/2026-q3-plan.md\r\n```\r\n\r\nOn macOS, `trash` moves files to `~/.Trash/` instead of permanently deleting them, so you can recover it by moving it back to its original location.\r\n"]
[0.004, "o", "\r\n# Case: remove-merge-leftovers  with 0.6666666666666666  without 0\r\n"]
[0.004, "o", "## with the rune\r\n"]
[0.004, "o", "```bash\r\nfind src -name '*.orig' -type f -exec trash {} +\r\n```\r\n"]
[0.005, "o", "## without the rune\r\n"]
[0.003, "o", "```bash\r\nfind src/ -name \"*.orig\" -delete\r\n```\r\n"]
