# The format is runeADR, and its public home is
# https://github.com/runedeck/adr. This schema mirrors the home's
# adr.mdschema, and a format change lands at the home first.
#
# One difference: `responsible`, `accountable`, and `upstream` are optional
# here. Each has a bare name and an `x-rune-` long form, and this schema
# cannot state that either form satisfies the field.
# scripts/check-decision-fields enforces that rule.
frontmatter:
    fields:
        - name: title
          type: string
        - name: description
          type: string
        - name: type
          type: string
        - name: category
          type: string
        - name: tags
          type: array
        - name: status
          type: string
        - name: created
          format: date
        - name: updated
          format: date
        - name: author
          type: string
        - name: project
          type: string
        - name: related
          type: array
          optional: true
        - name: responsible
          type: array
          optional: true
        - name: accountable
          type: array
          optional: true
        - name: consulted
          type: array
          optional: true
        - name: informed
          type: array
          optional: true
        - name: upstream
          type: array
          optional: true

heading_rules:
    no_skip_levels: true
    max_depth: 3

structure:
    - heading:
          pattern: "^# .+"
          regex: true
      allow_additional: true
      children:
          - heading:
                pattern: "## Context and Problem Statement"
            allow_additional: true
            word_count:
                min: 20
          - heading:
                pattern: "## Decision Drivers"
            optional: true
            allow_additional: true
            lists:
                - min: 1
          - heading:
                pattern: "## Considered Options"
            allow_additional: true
            lists:
                - min: 1
          - heading:
                pattern: "## Decision Outcome"
            allow_additional: true
          - heading:
                pattern: "## Consequences"
            optional: true
            allow_additional: true
            lists:
                - min: 1
          - heading:
                pattern: "## More Information"
            optional: true
            allow_additional: true
          - heading:
                pattern: "## Audit"
            optional: true
            allow_additional: true
