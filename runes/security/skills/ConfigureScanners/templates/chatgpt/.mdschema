heading_rules:
    no_skip_levels: true
    unique_per_level: true
    max_depth: 2

structure:
    - heading:
          pattern: "^# .+ Scanner$"
          regex: true
      count:
          max: 1
      children:
          - heading: "## Input checks"

          - heading: "## Authority"

          - heading: "## Browser controls"

          - heading: "## Destination controls"
            optional: true

          - heading: "## Search terms"

          - heading: "## Time window"

          - heading: "## Completion accounting"
            optional: true

          - heading: "## Coverage"

          - heading: "## Findings"

          - heading: "## Context rules"
            optional: true

          - heading: "## Evidence"

          - heading: "## Status"

          - heading: "## Final checks"

          - heading: "## Notification"
