#!/usr/bin/env bash
# Wrapper around ssh-keygen that bypasses macOS launchd's ssh-agent for git
# commit signing. Apple's bundled ssh-agent lacks libfido2 middleware and
# refuses to sign with sk-ssh-ed25519 (FIDO2) keys. By unsetting SSH_AUTH_SOCK,
# ssh-keygen goes direct to libfido2 → YubiKey, which handles touch + PIN.
# See ../CommitSigning.md for installation and diagnosis.
ssh_keygen=""
for candidate in \
    /opt/homebrew/opt/openssh/bin/ssh-keygen \
    /usr/local/opt/openssh/bin/ssh-keygen \
    /opt/homebrew/bin/ssh-keygen \
    /usr/local/bin/ssh-keygen; do
    [ -x "$candidate" ] || continue
    ssh_keygen=$candidate
    break
done

[ -n "$ssh_keygen" ] || {
    echo "git-ssh-sign-macos: Homebrew ssh-keygen was not found" >&2
    exit 127
}
exec env -u SSH_AUTH_SOCK "$ssh_keygen" "$@"
