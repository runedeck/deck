# A routine file: the behavior a Claude Code routine reads from the deck at
# run time. The stub in the provider names the file and supplies the values
# that the Inputs section lists. The README is not a routine and is not
# checked against this schema.
frontmatter:
    fields:
        - name: type
          type: string
          enum: [routine]
        - name: description
          type: string

heading_rules:
    no_skip_levels: true
    unique_per_level: true
    max_depth: 2

structure:
    - heading:
          pattern: "^# .+"
          regex: true
      count:
          max: 1
      children:
          - heading: "## Inputs"
            lists:
                - min: 1

          - heading: "## Authority"

          - heading: "## Startup checks"
            optional: true

          - heading: "## Scope"

          - heading: "## Permitted operations"

          - heading: "## Prohibited operations"

          - heading: "## Procedure"

          - heading: "## Status"

          - heading: "## Notification"

          - heading: "## Final checks"
