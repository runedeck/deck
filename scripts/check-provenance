#!/usr/bin/env python3
"""Check the provenance sidecar of each named rune file.

The subject digest must match the file content. Dependency digests
stay untouched: an adopted rune keeps its upstream source digest.
Use --fix to rewrite a stale subject digest in place.
"""
import hashlib
import pathlib
import re
import sys


def main():
    fix = "--fix" in sys.argv
    names = [a for a in sys.argv[1:] if a != "--fix"]
    stale = 0
    for name in names:
        path = pathlib.Path(name)
        if not path.is_file():
            continue
        sidecar = path.parent / ".provenance" / (path.name + ".yaml")
        if not sidecar.is_file():
            continue
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        text = sidecar.read_text()
        match = re.search(r"subject:\n(?:.*\n)*?\s*sha256: ([0-9a-f]{64})", text)
        if match is None:
            print(f"no subject digest: {sidecar}")
            stale += 1
            continue
        if match.group(1) == digest:
            continue
        if fix:
            sidecar.write_text(text[: match.start(1)] + digest + text[match.end(1) :])
            print(f"updated {sidecar}")
        else:
            print(f"stale subject digest: {sidecar}")
            stale += 1
    if stale and not fix:
        print("run: python3 scripts/check-provenance --fix <file>...")
    return 1 if stale else 0


if __name__ == "__main__":
    sys.exit(main())
