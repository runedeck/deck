#!/usr/bin/env python3
"""Check that each decision record id under docs/decisions/ is unique.

A record file is named `<FAMILY>-<NNNN> <Title>.md`. Two files with the
same `<FAMILY>-<NNNN>` are a collision. A gap in the sequence is valid:
a number is never reused.
"""
import collections
import pathlib
import re
import sys

RECORD = re.compile(r"^([A-Z]+-\d{4}) ")


def check(root):
    seen = collections.defaultdict(list)
    decisions = root / "docs" / "decisions"
    if not decisions.is_dir():
        return []
    for path in sorted(decisions.glob("*.md")):
        match = RECORD.match(path.name)
        if match:
            seen[match.group(1)].append(path.name)
    return [
        f"{record_id} names {len(names)} records: " + ", ".join(names)
        for record_id, names in sorted(seen.items())
        if len(names) > 1
    ]


def main():
    root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".")
    errors = check(root)
    for line in errors:
        print(line)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
