#!/usr/bin/env python3
"""Write the glossary pages under docs/specs/glossary/ from the ontology, or
check that every page is current.

    scripts/fallback/generate-glossary                write every page and the index
    scripts/fallback/generate-glossary --check        exit 1 when any page differs from the ontology
    scripts/fallback/generate-glossary [--check] DIR  render another root, never through rune

The ontology (ontology/rune.ttl) is the one definition of every term. The
generator writes one page per labeled term, named after the label in kebab
case, plus index.md, and the drift check regenerates every page and
compares the bytes, so a hand edit is caught. `rune spec glossary --write`
and `--check` write and check the same bytes (cli change
render-spec-glossary). This script hands over to rune when the installed
rune writes the directory, which it probes on a scratch copy of the
ontology, and renders the bytes itself otherwise.

A stale page for a term the ontology no longer has, or the single
docs/specs/glossary.md the directory replaced, is reported and left in
place: this script writes, it never deletes.
"""
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import termlib

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent


def rune_writes_directory():
    """True when the installed rune's `spec glossary --write` writes the
    directory of pages. Probed on a scratch copy so a rune that still writes
    the single file leaves no stale file behind."""
    rune = shutil.which("rune")
    if not rune:
        return False
    with tempfile.TemporaryDirectory() as scratch:
        probe = pathlib.Path(scratch)
        (probe / termlib.ONTOLOGY).parent.mkdir(parents=True)
        (probe / termlib.GLOSSARY).parent.mkdir(parents=True)
        shutil.copyfile(ROOT / termlib.ONTOLOGY, probe / termlib.ONTOLOGY)
        run = subprocess.run([rune, "spec", "glossary", "--write", "--source", str(probe)], capture_output=True, text=True, check=False)
        return run.returncode == 0 and (probe / termlib.GLOSSARY / "index.md").is_file()


def write(root):
    written, total, stale = termlib.write_pages(root)
    print(f"wrote {written} of {total} files under {termlib.GLOSSARY}")
    for path in stale:
        print(f"stale: {path} is not a page the ontology renders; remove it")
    return 0


def check(root):
    pages = termlib.load(root).render()
    directory = root / termlib.GLOSSARY
    problems = []
    for name, text in pages.items():
        path = directory / name
        if not path.is_file():
            problems.append(f"{termlib.GLOSSARY / name}: missing")
        elif path.read_text() != text:
            problems.append(f"{termlib.GLOSSARY / name}: differs from the ontology")
    problems.extend(f"{path}: stale, not a page the ontology renders" for path in termlib.stale_files(root, pages))
    for line in problems:
        print(line)
    if problems:
        print(f"{termlib.GLOSSARY} is stale; run scripts/fallback/generate-glossary and remove what it reports as stale")
        return 1
    print(f"{termlib.GLOSSARY}: {len(pages)} files current")
    return 0


def main():
    args = sys.argv[1:]
    check_mode = "--check" in args
    roots = [arg for arg in args if not arg.startswith("--")]
    if roots:
        root = pathlib.Path(roots[0]).resolve()
        return check(root) if check_mode else write(root)
    if rune_writes_directory():
        os.chdir(ROOT)
        os.execvp("rune", ["rune", "spec", "glossary", "--check" if check_mode else "--write"])
    return check(ROOT) if check_mode else write(ROOT)


if __name__ == "__main__":
    sys.exit(main())
