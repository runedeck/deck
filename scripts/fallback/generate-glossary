#!/usr/bin/env python3
"""Write docs/specs/glossary.md from the ontology, or check that it is current.

    scripts/fallback/generate-glossary            write the glossary
    scripts/fallback/generate-glossary --check    exit 1 when the file differs from the ontology

The ontology (ontology/rune.ttl) is the one definition of every term.
`rune spec glossary --write` and `--check` render and check the file
(cli change render-spec-glossary). This script hands over to rune when the
installed rune has the flag and renders the same bytes itself otherwise:
one `- **label**: comment [TAG]` line per class, property, or concept that
carries an rdfs:label, sorted by label, then the reference definitions.
"""
import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
ONTOLOGY = ROOT / "ontology" / "rune.ttl"
GLOSSARY = ROOT / "docs" / "specs" / "glossary.md"
NS = "https://runedeck.ai/ns#"
WRITE_COMMAND = "rune spec glossary --write"
BLOCK = re.compile(r"^rune:(\w+) a (rdfs:Class|rdf:Property|skos:Concept)\b(.*?)\s\.\s*$", re.M | re.S)
LABEL = re.compile(r'rdfs:label "([^"]+)"')
COMMENT = re.compile(r'rdfs:comment "((?:[^"\\]|\\.)*)"')
PRECEDENCE = {"rdfs:Class": 0, "rdf:Property": 1, "skos:Concept": 2}

HEADER = f"""# Glossary

Generated from `ontology/rune.ttl` by `{WRITE_COMMAND}`. Do not edit this file. Change the ontology.
A specification sets a term in italics at first use and cites it as `*term* [TERM]` with
`[TERM]: {NS}Term` at the end of the file.

"""


def terms():
    """(label, kind, name, comment) for every labeled term, in rune's order:
    by label, then the class before the property that shares it, then by name."""
    found = []
    for match in BLOCK.finditer(ONTOLOGY.read_text()):
        name, kind, body = match.group(1), match.group(2), match.group(3)
        label, comment = LABEL.search(body), COMMENT.search(body)
        if label:
            text = comment.group(1).replace('\\"', '"') if comment else ""
            found.append((label.group(1), PRECEDENCE[kind], name, text))
    return sorted(found)


def tags(entries):
    """Reference tag by name: the local name in upper case. Markdown reference
    labels are case-insensitive, so when two names collide the class keeps the
    plain tag and every later term takes -KEY suffixes until its tag is unique."""
    found, taken = {}, set()
    for label, kind, name, _ in sorted(entries, key=lambda t: (t[1], t[0])):
        tag = name.upper()
        while tag in taken:
            tag += "-KEY"
        taken.add(tag)
        found[name] = tag
    return found


def render():
    entries = terms()
    tag = tags(entries)
    lines = []
    for label, _, name, comment in entries:
        definition = f" {comment}" if comment else ""
        lines.append(f"- **{label}**:{definition} [{tag[name]}]")
    refs = [f"[{tag[name]}]: {NS}{name}" for _, _, name, _ in entries]
    return HEADER + "\n".join(lines) + "\n\n" + "\n".join(refs) + "\n"


def rune_has_write():
    rune = shutil.which("rune")
    if not rune:
        return False
    out = subprocess.run([rune, "spec", "glossary", "--help"], capture_output=True, text=True)
    return "--write" in out.stdout


def main():
    check = "--check" in sys.argv[1:]
    if rune_has_write():
        os.chdir(ROOT)
        os.execvp("rune", ["rune", "spec", "glossary", "--check" if check else "--write"])
    wanted = render()
    if check:
        current = GLOSSARY.read_text() if GLOSSARY.is_file() else ""
        if current != wanted:
            print(f"{GLOSSARY.relative_to(ROOT)} is stale; run scripts/fallback/generate-glossary")
            return 1
        print(f"{GLOSSARY.relative_to(ROOT)} is current")
        return 0
    GLOSSARY.write_text(wanted)
    print(f"wrote {GLOSSARY.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
