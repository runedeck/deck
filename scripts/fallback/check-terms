#!/usr/bin/env python3
"""Check every term link in the repository against the ontology.

    scripts/fallback/check-terms         check the repository, through rune when it has the link model
    scripts/fallback/check-terms DIR     check another root against its own ontology, never through rune

A defined term is a reference link to its generated glossary page:
`*[analysis tool][ANALYSISTOOL]*` at the first use in a file,
`[analysis tool][ANALYSISTOOL]` after it, and
`[ANALYSISTOOL]: ../../specs/glossary/analysis-tool.md` at the end of the
file. Plain italics are emphasis and are not checked. The findings carry
the meaning of rune's spec-term-* and delta-term-* diagnostics:

- term-undefined (error): the link resolves to no ontology entry.
- term-draft (warning): the term carries `rune:status "draft"`; the archiver refuses the change.
- term-first-use (error): the first use in a file is not emphasized, or a later use is.
- term-page (error): the page is missing, or its bytes differ from the render.
- term-legacy (warning): the old `*term* [TAG]` form with an ontology IRI definition; run scripts/fallback/fix-terms --links.

rumdl checks the rest: MD052 reports an undefined tag and MD053 an unused
definition. Without a directory argument the script hands over to
`rune spec validate` and `rune validate` when the installed rune has the
link model (probe: `rune spec fix` exists), so the two never disagree.
"""
import json
import pathlib
import shutil
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import termlib

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
FIX = "scripts/fallback/fix-terms"
GENERATE = "scripts/fallback/generate-glossary"


def check_file(root, path, index, rendered):
    raw = path.read_text(errors="replace")
    text = termlib.blank_code(raw)
    rel = path.relative_to(root)
    found = []

    def report(offset, severity, name, message):
        found.append(termlib.Finding(rel, termlib.line_of(text, offset), severity, name, message))

    resolved = {}
    for match in termlib.DEFINITION.finditer(text):
        tag, target = match.group(1), match.group(2)
        res = termlib.resolve(root, path, tag, target, index)
        if res.form is None:
            continue
        resolved[tag] = res
        if res.name is None:
            report(match.start(), "error", "term-undefined", f"[{tag}] resolves to no ontology term; define it in ontology/rune.ttl or run {FIX} --terms for a draft")
            continue
        term = index.by_name[res.name]
        page_name = index.file_of[res.name]
        if res.form == "legacy":
            new = termlib.relative_link(path, root, page_name)
            report(match.start(), "warning", "term-legacy", f"[{tag}] points at the ontology IRI; write `[{tag}]: {new}` and mark the term as `*[{term.label}][{tag}]*`, or run {FIX} --links")
        elif not res.page.is_file():
            report(match.start(), "error", "term-page", f"{termlib.GLOSSARY / page_name} is missing; run {GENERATE}")
        elif res.page.name != page_name:
            report(match.start(), "error", "term-page", f"{res.page.relative_to(root)} is not the page the ontology renders for '{term.label}' ({page_name}); run {GENERATE} and point [{tag}] at it")
        elif res.page.read_text() != rendered[page_name]:
            report(match.start(), "error", "term-page", f"{termlib.GLOSSARY / page_name} differs from the ontology; run {GENERATE}")
        if term.status == "draft":
            report(match.start(), "warning", "term-draft", f"[{tag}] links the draft term '{term.label}'; define it in ontology/rune.ttl before archive")

    seen = set()
    for match in termlib.REF_LINK.finditer(text):
        opened, label, tag, closed = match.groups()
        res = resolved.get(tag)
        if res is None or res.name is None:
            continue
        emphasized = opened == "*" and closed == "*"
        if res.name not in seen:
            seen.add(res.name)
            if not emphasized:
                report(match.start(), "error", "term-first-use", f"first use of [{label}][{tag}] is not emphasized; write `*[{label}][{tag}]*`")
        elif emphasized:
            report(match.start(), "error", "term-first-use", f"later use of [{label}][{tag}] is emphasized; write `[{label}][{tag}]`")
    return found


def check(root):
    root = pathlib.Path(root).resolve()
    index = termlib.load(root)
    rendered = index.render()
    found = []
    for path in termlib.markdown_files(root):
        found.extend(check_file(root, path, index, rendered))
    return found


def rune_has_link_model():
    rune = shutil.which("rune")
    return bool(rune) and subprocess.run([rune, "spec", "fix", "-h"], capture_output=True, check=False).returncode == 0


def rune_findings():
    """The same check from rune: every term finding with its severity, so
    this script and rune never disagree and a draft term stays visible
    while a change is active. The hook fails on an error only."""
    spec = subprocess.run(["rune", "spec", "validate", "--json"], capture_output=True, text=True, check=False)
    repo = subprocess.run(["rune", "validate", "--json"], capture_output=True, text=True, check=False)
    found = []
    for item in json.loads(spec.stdout or "[]"):
        if "term" in item["code"]:
            found.append((item["severity"], f"{item['severity']}[{item['code']}]: {item['path']}:{item['line'] or 0}: {item['message']}"))
    report = json.loads(repo.stdout or "{}")
    for severity in ("error", "warning"):
        found.extend((severity, line) for line in report.get(severity + "s", []) if "term" in line)
    return found


def main():
    if sys.argv[1:]:
        found = check(sys.argv[1])
    elif rune_has_link_model():
        lines = rune_findings()
        for _severity, line in lines:
            print(line)
        return 1 if any(severity == "error" for severity, _line in lines) else 0
    else:
        found = check(ROOT)
    for f in found:
        print(f"{f.severity}[{f.name}]: {f.path}:{f.line}: {f.message}")
    errors = sum(1 for f in found if f.severity == "error")
    print(f"terms: {len(found)} findings, {errors} errors")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
