#!/bin/bash
# check-authorship: verify that every outgoing commit carries a listed identity.
# The script applies the same rules as the ci/authorship workflow:
#   1. The commit author appears in the authors: list of authors.yaml.
#   2. The author does not repeat as a Co-Authored-By trailer.
#   3. Every Co-Authored-By trailer appears in the authors: list or the
#      trailers: list. The trailers: list is valid only for trailers.
# prek sets PRE_COMMIT_FROM_REF and PRE_COMMIT_TO_REF at the pre-push stage.
# A manual run falls back to the merge base with origin/main.
set -o pipefail

from="${PRE_COMMIT_FROM_REF:-}"
to="${PRE_COMMIT_TO_REF:-HEAD}"
# A push that creates the remote branch reports the zero object id.
case "$from" in
    '' | 0000000000000000000000000000000000000000)
        from=$(git merge-base origin/main "$to" 2>/dev/null) \
            || { echo "check-authorship: cannot resolve origin/main; set PRE_COMMIT_FROM_REF"; exit 1; }
        ;;
esac

# Section-aware reads: an entry under trailers: is valid only as a
# Co-Authored-By line. Reading both lists with one grep would let a
# trailer alias validate a wrong author field.
identities=$(awk '/^[^ #]/ { s = /^authors:/ } s && /^    - / { sub(/^    - /, ""); print }' authors.yaml)
trailer_identities=$(awk '/^[^ #]/ { s = /^trailers:/ } s && /^    - / { sub(/^    - /, ""); print }' authors.yaml)
[ -n "$identities" ] || { echo "authors.yaml lists no identities"; exit 1; }

listed() {
    printf '%s\n' "$identities" | grep -qFx "$1"
}
trailer_listed() {
    [ -n "$trailer_identities" ] && printf '%s\n' "$trailer_identities" | grep -qFx "$1"
}

# The range and trailer reads are captured before their loops so a failed
# git invocation fails the check instead of feeding an empty loop.
range=$(git log --format='%H%x09%an <%ae>' "$from..$to") \
    || { echo "could not list commits in $from..$to"; exit 1; }
failures=0
while IFS=$'\t' read -r commit author; do
    [ -n "$commit" ] || continue
    if ! listed "$author"; then
        echo "$commit: author '$author' is not in authors.yaml (expected 'Display Name (model-id) <address>')"
        failures=1
    fi
    trailers=$(git show -s --format='%(trailers:key=Co-Authored-By,valueonly)' "$commit") \
        || { echo "$commit: could not read Co-Authored-By trailers"; exit 1; }
    while read -r trailer; do
        [ -n "$trailer" ] || continue
        if [ "$trailer" = "$author" ]; then
            echo "$commit: author repeated as Co-Authored-By"
            failures=1
        elif ! listed "$trailer" && ! trailer_listed "$trailer"; then
            echo "$commit: Co-Authored-By '$trailer' is neither a listed identity nor a listed trailer attribution"
            failures=1
        fi
    done <<< "$trailers"
done <<< "$range"
[ "$failures" -eq 0 ] && echo "every commit in $from..$to carries a listed identity."
exit "$failures"
